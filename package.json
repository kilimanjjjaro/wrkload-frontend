    "cookies-next": "4.0.0",
    "dayjs": "1.11.10",
    "framer-motion": "10.16.4",
    "jwt-decode": "4.0.0",
    "next": "13.2.4",
    "react": "18.2.0",
    "react-avatar-editor": "13.0.0",
    "react-compare-image": "3.4.0",
    "react-dom": "18.2.0",
    "react-masonry-css": "1.0.16",
