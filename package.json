    "dayjs": "1.11.23",
    "jwt-decode": "4.0.0",
    "lenis": "1.3.27",
    "motion": "14.14.0",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-avatar-editor": "16.0.0",
    "react-compare-image": "3.5.23",
    "react-dom": "19.3.1",
