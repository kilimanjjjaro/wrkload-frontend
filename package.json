{
  "name": "wrkload-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "test:visual:update": "playwright test --project=visual-desktop --project=visual-mobile --update-snapshots",
    "test:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:e2e && pnpm test:visual"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@motionone/utils": "10.18.0",
    "@vercel/analytics": "2.0.1",
    "atropos": "2.0.2",
    "axios": "1.21.1",
    "clsx": "2.1.1",
    "cookies-next": "6.1.1",
    "dayjs": "1.11.23",
    "jwt-decode": "4.0.0",
    "lenis": "1.3.27",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-avatar-editor": "16.0.0",
    "react-compare-image": "3.5.23",
    "react-dom": "19.3.1",
    "react-masonry-css": "1.0.16",
    "react-wrap-balancer": "1.1.1",
    "sonner": "2.0.8",
    "swiper": "14.4.0",
    "swr": "2.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-avatar-editor": "13.0.4",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "volta": {
    "node": "26.13.1"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
